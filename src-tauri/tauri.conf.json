{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hrl-core",
  "version": "0.1.0",
  "identifier": "com.hector.hrl-core",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "hrl-core",
        "width": 1000,
        "height": 680,
        "minWidth": 1000,
        "minHeight": 680,
        "maxWidth": 1000,
        "maxHeight": 680,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": []
    }
  }
}
